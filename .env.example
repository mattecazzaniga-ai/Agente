# Copia in .env.local (sviluppo) o nelle variabili d'ambiente di Vercel (produzione)
NEXT_PUBLIC_SUPABASE_URL=https://<il-tuo-progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chiave anon del progetto: Settings → API>
NEXT_PUBLIC_SITE_URL=https://<il-tuo-dominio>.vercel.app
# 1 dopo aver configurato Google in Supabase (Authentication → Providers → Google)
NEXT_PUBLIC_GOOGLE_ABILITATO=0
