# Copy to .env for local runs (never commit .env). All values are optional.

# Claude API — REAL COST. Without a key the agent uses the offline heuristic brain.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
# or claude-sonnet-5 for ~60% lower cost
AGENT_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium
# global hard cap on Claude spend per UTC day
MAX_LLM_USD_PER_DAY=1.00
MAX_LLM_USD_PER_TICK=0.40
# or heuristic
LLM_BUDGET_FALLBACK=measure_only

# Phase 2: real web research (1 = simulated research only)
AGENT_PHASE=2
MAX_WEB_SEARCHES_PER_TICK=5
MAX_WEB_FETCHES_PER_TICK=3
WEB_FETCH_MAX_CONTENT_TOKENS=6000

# Economy (virtual EUR in Phase 1)
INITIAL_CAPITAL=50
# Phase 5
REPRODUCTION_ENABLED=false
MAX_POPULATION=1
CHARGE_LLM_COST_TO_CAPITAL=true

# Safety limits
MAX_BUDGET_PER_EXPERIMENT=15
MAX_CAPITAL_FRACTION_PER_EXPERIMENT=0.3
MAX_CAPITAL_FRACTION_COMMITTED=0.5
RESERVE_FRACTION=0.2
MAX_CONCURRENT_EXPERIMENTS=2
MAX_LAUNCHES_PER_DAY=3
APPROVAL_THRESHOLD=12
MAX_TOOL_CALLS_PER_TICK=16
MAX_RESEARCH_CALLS_PER_TICK=6
MIN_MINUTES_BETWEEN_TICKS=20
AGENT_KILL_SWITCH=0

DATA_DIR=data
WORLD_SEED=20260923
