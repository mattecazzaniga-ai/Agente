            "relazione": {
              "con": "genitore",
              "delta": 15
            },
            "reputazione": 3,
            "morale": -2
          },
          "esito": "Stanchezza tanta. Rimpianti nessuno."
        },
        {
          "id": "b",
          "testo": "Paghi una badante",
          "requisiti": {
            "risparmi_min": 8000
          },
          "tratti_favoriti": [
            "prudente",
            "ambizioso"
          ],
          "effetti": {
            "risparmi": -7500,
            "relazione": {
              "con": "genitore",
              "delta": 5
            }
          },
          "esito": "Costa, ma {genitore} è in buone mani."
        },
        {
          "id": "c",
          "testo": "Chiedi a {fratello} di pensarci",
          "tratti_favoriti": [
            "egoista"
          ],
          "effetti": {
            "relazione": {
              "con": "fratello",
              "delta": -12
            },
            "morale": -3
          },
          "esito": "Lo fa. Ma tra voi qualcosa si incrina."
        }
      ]
    },
    {
      "id": "famiglia_azienda_estate",
      "tema": "famiglia",
      "titolo": "L'azienda di famiglia",
      "condizioni": {
        "eta": [
          14,
          20
        ],
        "azienda_famiglia": true
      },
      "peso": 4,
      "testi": [
        "In famiglia c'è bisogno di una mano in azienda durante l'estate. Tutti si aspettano che tu dica di sì.",
        "Nel negozio di famiglia manca un commesso per agosto. «Così impari», dice {padre}.",
        "Ti propongono di passare l'estate in azienda a vedere come funziona davvero."
      ],
      "scelte": [
        {
          "id": "a",
          "testo": "Ci vai e ti impegni",
          "tratti_favoriti": [
            "ambizioso",
            "prudente",
            "generoso"
          ],
          "effetti": {
            "risparmi": 900,
            "relazione": {
              "con": "genitore",
              "delta": 6
            },
            "stanchezza": 5,
            "flag": "esperienza_azienda"
          },
          "esito": "Capisci quanta fatica c'è dietro il nome di famiglia."
        },
        {
          "id": "b",
          "testo": "Dici di no: quella è la loro vita",
          "tratti_favoriti": [
            "indipendente",
            "creativo"
          ],
          "effetti": {
            "felicita": 3,
            "relazione": {
              "con": "genitore",
              "delta": -5
