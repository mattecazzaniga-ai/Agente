        {
          "id": "b",
          "testo": "Gli fai vedere il tuo disegno più bello",
          "tratti_favoriti": [
            "creativo",
            "sicuro"
          ],
          "effetti": {
            "felicita": 3,
            "reputazione": 2
          },
          "esito": "Ride, e ne fa uno anche lui."
        },
        {
          "id": "c",
          "testo": "Resti per conto tuo",
          "tratti_favoriti": [
            "solitario",
            "insicuro"
          ],
          "effetti": {
            "morale": -2
          },
          "esito": "Va bene così, ma l'intervallo dura tanto."
        }
      ]
    },
